<title>정일우 AI 서비스 포트폴리오</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+KR:wght@400;500;600;700&display=swap">
<style>
/* Layout: 단일 열 문서형. 남색 히어로만 강한 면으로 쓰고 나머지는 선과 여백으로 구분한다.
   금색 = 사람이 확인하고 확정하는 지점. 기존 포트폴리오의 남색+금색 정체성을 잇는다. */
:root {
  --bg: #f2f4f9;
  --surface: #ffffff;
  --surface-2: #e8ecf4;
  --ink: #12203d;
  --ink-2: #47526b;
  --line: #d3dae8;
  --navy: #1a2b4e;
  --on-navy: #f3f5fb;
  --on-navy-2: #b9c3dc;
  --gold: #d4ac0d;
  --gold-ink: #7a5d00;
  --gold-soft: rgba(212, 172, 13, 0.14);
  --c-code: #2f5fb3; --c-code-soft: rgba(47, 95, 179, 0.09);
  --c-llm: #b8620a; --c-llm-soft: rgba(224, 123, 0, 0.11);
  --c-stop: #b4234f; --c-stop-soft: rgba(214, 51, 108, 0.07);
  --font-body: "IBM Plex Sans KR", "Noto Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", system-ui, sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0c1322; --surface: #131c31; --surface-2: #1b2744; --ink: #e8ecf6; --ink-2: #a3aec6;
    --line: #28344f; --navy: #172a55; --on-navy: #f1f4fb; --on-navy-2: #b4bfd9;
    --c-code: #86adf0; --c-code-soft: rgba(134, 173, 240, 0.13); --c-llm: #f2a652; --c-llm-soft: rgba(242, 166, 82, 0.13); --c-stop: #f28fad; --c-stop-soft: rgba(242, 143, 173, 0.09);
    --gold: #e6bb2a; --gold-ink: #eac24a; --gold-soft: rgba(230, 187, 42, 0.14); color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0c1322; --surface: #131c31; --surface-2: #1b2744; --ink: #e8ecf6; --ink-2: #a3aec6;
  --line: #28344f; --navy: #172a55; --on-navy: #f1f4fb; --on-navy-2: #b4bfd9;
  --c-code: #86adf0; --c-code-soft: rgba(134, 173, 240, 0.13); --c-llm: #f2a652; --c-llm-soft: rgba(242, 166, 82, 0.13); --c-stop: #f28fad; --c-stop-soft: rgba(242, 143, 173, 0.09);
  --gold: #e6bb2a; --gold-ink: #eac24a; --gold-soft: rgba(230, 187, 42, 0.14); color-scheme: dark;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
body {
  background: var(--bg); color: var(--ink);
  font-family: var(--font-body); font-size: 15.5px; line-height: 1.7;
  word-break: keep-all; overflow-wrap: break-word;
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  padding-block: 0 56px;
}
body::before {
  content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px);
  background: var(--bg); z-index: 30;
}
.wrap { max-width: 1040px; margin: 0 auto; }
:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; border-radius: 4px; }

/* 상단 바 */
.top {
  position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20;
  display: flex; align-items: center; gap: 18px; padding: 10px 0;
  background: var(--bg); border-bottom: 1px solid var(--line);
}
.brand { font-weight: 700; white-space: nowrap; font-size: 14px; }
.top nav { display: flex; gap: 2px; overflow-x: auto; min-width: 0; scrollbar-width: none; }
.top nav::-webkit-scrollbar { display: none; }
.top nav a { text-decoration: none; padding: 6px 10px; border-radius: 6px; font-size: 13.5px; color: var(--ink-2); white-space: nowrap; }
.top nav a:hover, .top nav a.on { color: var(--ink); background: var(--surface-2); }
.top nav a.on { font-weight: 600; }

/* 히어로 */
.hero { background: var(--navy); color: var(--on-navy); border-radius: 14px; margin-top: 20px; padding: clamp(24px, 5vw, 52px); }
.eyebrow { font-family: var(--font-mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--gold); margin: 0 0 14px; }
.hero h1 { margin: 0; font-size: clamp(26px, 4.8vw, 44px); line-height: 1.25; font-weight: 700; letter-spacing: -0.02em; text-wrap: balance; max-width: 22em; }
.hero h1 em { font-style: normal; color: var(--gold); }
.hero .lead { margin: 16px 0 0; max-width: 40em; color: var(--on-navy-2); font-size: clamp(15px, 1.9vw, 17px); }
.wave-box { margin-top: 26px; }
.wave-box svg { display: block; width: 100%; height: auto; max-width: 620px; }
.wave-cap { display: flex; justify-content: space-between; max-width: 620px; font-family: var(--font-mono); font-size: 11.5px; color: var(--on-navy-2); letter-spacing: .06em; margin-top: 6px; }
.hero-meta { margin-top: 22px; padding-top: 16px; border-top: 1px solid rgba(255,255,255,.16); font-size: 13.5px; color: var(--on-navy-2); }
.hero-meta b { color: var(--on-navy); font-weight: 600; }

/* 섹션 */
section { padding-block: clamp(38px, 6vw, 60px) 0; scroll-margin-top: 64px; }
.kicker { font-family: var(--font-mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--gold-ink); margin: 0 0 8px; }
h2 { margin: 0; font-size: clamp(22px, 3.2vw, 29px); line-height: 1.3; font-weight: 700; letter-spacing: -0.015em; text-wrap: balance; }
h3 { margin: 0; font-size: 17px; line-height: 1.4; font-weight: 700; }
.sec-lead { margin: 10px 0 0; max-width: 44em; color: var(--ink-2); }
.num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }

/* 한눈에 */
.glance { margin-top: 18px; border-top: 2px solid var(--ink); }
.glance .row { display: grid; gap: 6px 22px; padding: 16px 0; border-bottom: 1px solid var(--line); grid-template-columns: 124px minmax(0, 1.7fr) minmax(0, 1fr) minmax(0, 1fr); align-items: start; }
.glance .lb { display: none; font-family: var(--font-mono); font-size: 11px; letter-spacing: .08em; color: var(--gold-ink); }
.glance .todo { color: var(--ink-2); font-size: 13.5px; border-bottom: 1px dashed var(--ink-2); display: inline-block; }
.glance .row.head { padding: 9px 0; font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .08em; color: var(--ink-2); text-transform: uppercase; }
.glance .n { font-weight: 700; font-size: 16px; }
.glance .p { font-size: 14.5px; }
.glance .p small, .glance .w small { display: block; color: var(--ink-2); font-size: 13px; margin-top: 2px; }
.glance .w { font-size: 14.5px; }
.foot { margin: 10px 0 0; font-size: 13px; color: var(--ink-2); }
@media screen and (max-width: 860px) {
  .glance .row { grid-template-columns: minmax(0, 1fr); }
  .glance .row.head { display: none; }
  .glance .lb { display: block; }
}

/* 흐름도 */
.lane { margin-top: 26px; }
.lane h3 { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.lane h3 span { font-weight: 400; font-size: 13.5px; color: var(--ink-2); }
ol.flow { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 22px; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); }
.flow li { position: relative; min-width: 0; padding: 12px 12px 14px; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; }
.flow li:not(:last-child)::after { content: "→"; position: absolute; right: -19px; top: 50%; transform: translateY(-50%); width: 16px; text-align: center; color: var(--ink-2); font-family: var(--font-mono); }
.flow .mod { display: block; font-family: var(--font-mono); font-size: 11px; color: var(--ink-2); letter-spacing: .04em; margin-bottom: 4px; }
.flow .t { display: block; font-weight: 600; line-height: 1.4; font-size: 14.5px; }
.flow .d { display: block; margin-top: 4px; font-size: 12.8px; line-height: 1.55; color: var(--ink-2); }
.flow li.human { border-color: var(--gold); box-shadow: inset 0 0 0 1px var(--gold); background: var(--gold-soft); }
.flow li.human .mod { color: var(--gold-ink); font-weight: 500; }
.legend { margin-top: 16px; font-size: 13.5px; color: var(--ink-2); display: flex; gap: 8px; align-items: center; }
.legend i { width: 14px; height: 14px; border: 1px solid var(--gold); background: var(--gold-soft); box-shadow: inset 0 0 0 1px var(--gold); border-radius: 3px; flex: none; }
@media screen and (max-width: 860px) {
  ol.flow { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  .flow li:not(:last-child)::after { content: "↓"; right: auto; left: 50%; top: auto; bottom: -22px; transform: translateX(-50%); }
}

/* 시스템별 본문 */
.sys-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 16px; margin-top: 4px; }
.period { font-family: var(--font-mono); font-size: 13px; color: var(--ink-2); }
ul.plain { margin: 16px 0 0; padding-left: 1.15em; max-width: 46em; }
ul.plain li { margin: 0 0 8px; line-height: 1.7; }
ul.plain li::marker { color: var(--gold-ink); }
ul.plain li b { font-weight: 600; }

.shots { display: grid; gap: 14px; margin-top: 22px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
.shot { margin: 0; min-width: 0; }
.shot.wide { grid-column: 1 / -1; }
.shot.wide .ph { aspect-ratio: 21 / 9; }
.shot.narrow { grid-column: 1 / -1; max-width: 400px; }
.algo-box { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 18px clamp(14px, 2.4vw, 22px) 20px; }
.algo-key { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 0 0 4px; font-size: 13px; color: var(--ink-2); }
.algo-key span { display: inline-flex; align-items: center; gap: 6px; }
.algo-key i { width: 14px; height: 14px; border-radius: 3px; border: 1px solid; flex: none; }
.algo-key i.k-code { border-color: var(--c-code); background: var(--c-code-soft); }
.algo-key i.k-llm { border-color: var(--c-llm); background: var(--c-llm-soft); }
.algo-key i.k-human { border-color: var(--gold); background: var(--gold-soft); }
ol.flow.algo { margin-top: 16px; }
.flow.algo li.code { border-color: var(--c-code); background: var(--c-code-soft); }
.flow.algo li.llm { border-color: var(--c-llm); background: var(--c-llm-soft); }
.flow.algo li.code .mod { color: var(--c-code); }
.flow.algo li.llm .mod { color: var(--c-llm); }
.algo-turn { margin: 12px 0 0; text-align: right; font-family: var(--font-mono); font-size: 12px; color: var(--ink-2); }
.algo-stop { margin: 16px 0 0; padding: 10px 14px; border: 1.5px dashed var(--c-stop); background: var(--c-stop-soft); border-radius: 8px; font-size: 14px; line-height: 1.65; }
.flowset { border: 1px solid var(--line); border-radius: 10px; background: var(--surface); padding: 0 16px; }
.flowset summary { cursor: pointer; padding: 14px 0; font-weight: 600; }
.flowimgs { padding: 0 0 16px; display: grid; gap: 6px; }
.flowimgs .img { display: block; border: 1px solid var(--line); border-radius: 8px; background: #fff; overflow: hidden; }
.flowimgs img { display: block; width: 100%; max-width: 760px; height: auto; margin: 0 auto; }
.flowimgs .cap { margin: 0 0 14px; font-size: 13px; color: var(--ink-2); }
.algo-stop b { color: var(--c-stop); font-weight: 600; }
.shot a.img { display: block; }
.shot img { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: 8px; background: #fff; }
.shot .ph {
  aspect-ratio: 16 / 10; max-width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
  border: 1.5px dashed var(--ink-2); border-radius: 8px; background: var(--surface); padding: 14px; text-align: center;
}
.shot .ph b { font-family: var(--font-mono); font-size: 11.5px; letter-spacing: .1em; color: var(--gold-ink); font-weight: 500; }
.shot .ph span { font-size: 13.5px; color: var(--ink-2); line-height: 1.55; }
.shot figcaption { margin-top: 8px; font-size: 13.5px; line-height: 1.6; }


.note { margin-top: 26px; padding: 12px 16px; background: var(--gold-soft); border-left: 3px solid var(--gold); font-size: 14.5px; line-height: 1.7; }
.note b { font-weight: 600; }
footer { margin-top: 56px; padding-top: 18px; border-top: 1px solid var(--line); font-size: 13px; color: var(--ink-2); }
footer p { margin: 0 0 6px; }

.print-btn { margin-left: auto; flex: none; display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); color: var(--gold-ink); font: 600 13px var(--font-body); cursor: pointer; }
.print-btn:hover { background: var(--surface-2); }

/* 인쇄 및 PDF 저장: A4 가로 */
@page { size: A4 landscape; margin: 10mm; }
@media print {
  :root:root:root {
    --bg: #fff; --surface: #fff; --surface-2: #e8ecf4; --ink: #12203d; --ink-2: #47526b; --line: #d3dae8;
    --navy: #1a2b4e; --on-navy: #f3f5fb; --on-navy-2: #b9c3dc; --gold: #d4ac0d; --gold-ink: #7a5d00;
    --gold-soft: rgba(212, 172, 13, 0.14);
    --c-code: #2f5fb3; --c-code-soft: rgba(47, 95, 179, 0.09); --c-llm: #b8620a; --c-llm-soft: rgba(224, 123, 0, 0.11);
    --c-stop: #b4234f; --c-stop-soft: rgba(214, 51, 108, 0.07);
    color-scheme: light;
  }
  * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
  html { scroll-behavior: auto; }
  body { padding: 0; font-size: 12.5px; line-height: 1.55; }
  body::before, .top { display: none !important; }
  /* 표지: 첫 페이지를 가득 채운다 (용지 높이 210mm − 여백 20mm = 190mm) */
  .hero { margin: 0; height: 186mm; padding: 0 16mm; border-radius: 0; display: flex; flex-direction: column; justify-content: center; break-after: page; }
  .hero h1 { font-size: 46px; max-width: 18em; }
  .hero .lead { font-size: 19px; max-width: 36em; margin-top: 22px; }
  .wave-box { margin-top: 34px; }
  .wave-box svg, .wave-cap { max-width: 100%; }
  .hero-meta { margin-top: 30px; font-size: 15px; }
  section { padding-top: 0; break-before: page; }
  .hero + section { break-before: auto; }
  h2, h3 { break-after: avoid; }
  .glance .row, .flow li, .shot, .algo-box, .note, .lane { break-inside: avoid; }

  /* 표: 한 페이지에 들어오도록 간격을 줄인다 */
  .glance .row { padding: 16px 0; font-size: 13px; }
  .glance .n { font-size: 15.5px; }
  .glance .p, .glance .w { font-size: 14px; }
  .glance .p small, .glance .w small { font-size: 12.5px; }

  /* 시스템 페이지: 왼쪽 설명, 오른쪽 화면 */
  #chat, #script, #meeting { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 26px; align-content: start; }
  #chat > .kicker, #chat > h2, #chat > .sys-head,
  #script > .kicker, #script > h2, #script > .sys-head,
  #meeting > .kicker, #meeting > h2, #meeting > .sys-head { grid-column: 1 / -1; }
  #chat > ul.plain, #script > ul.plain, #meeting > ul.plain { grid-column: 1; margin-top: 14px; font-size: 14px; line-height: 1.65; max-width: none; }
  #chat > .shots, #script > .shots, #meeting > .shots { grid-column: 2; grid-template-columns: minmax(0, 1fr); margin-top: 12px; gap: 10px; align-content: start; }
  .shot.narrow, .shot.wide { max-width: none; }
  .shot img { width: auto; max-width: 100%; margin: 0 auto; }
  .shot figcaption { font-size: 11px; margin-top: 4px; line-height: 1.45; }
  #chat .shot.narrow { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 12px; align-items: start; }
  #chat .shot.narrow figcaption { margin-top: 0; }
  #chat .shot.narrow img { max-height: 380px; margin: 0; }
  #chat .shot.wide img { max-height: 240px; }
  #script .shot img { max-height: 270px; }
  #meeting .shot.narrow { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 12px; align-items: start; }
  #meeting .shot.narrow figcaption { margin-top: 0; }
  #meeting .shot.narrow img { margin: 0; max-height: 140px; }
  #meeting .shot.wide img { max-height: 190px; }


  /* 상담결과지: 순서도는 위, 상세 분기 3장은 다음 페이지에 나란히 */
  #sheet ul.plain { margin-top: 12px; font-size: 13.5px; max-width: none; }
  #sheet ul.plain li { margin-bottom: 4px; }
  #sheet .shots { margin-top: 12px; gap: 8px; }
  .algo-box { padding: 10px 14px 12px; }
  ol.flow { gap: 18px; margin-top: 10px; }
  .flow li { padding: 8px 9px 9px; }
  .flow .t { font-size: 14px; }
  .flow .d { font-size: 12.5px; line-height: 1.5; }
  .algo-stop { font-size: 13px; margin-top: 10px; padding: 8px 12px; }
  .flowset { break-before: page; border: 0; padding: 0; }
  .flowset summary { list-style: none; font-size: 14px; padding: 0 0 8px; }
  .flowset summary::-webkit-details-marker { display: none; }
  .flowimgs { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: auto auto; grid-auto-flow: column; gap: 4px 14px; }
  .flowimgs img { width: auto; max-width: 100%; max-height: 150mm; margin: 0 auto; }
  .flowimgs .cap { font-size: 11px; margin: 0; text-align: center; }
  footer { margin-top: 24px; break-inside: avoid; }
}
</style>

<div class="wrap">
  <header class="top">
    <span class="brand">정일우 포트폴리오</span>
    <nav id="nav" aria-label="섹션 이동">
      <a href="#glance">주요 작업</a>
      <a href="#flow">흐름</a>
      <a href="#chat">강의 챗봇</a>
      <a href="#script">OO스크립트</a>
      <a href="#meeting">OO미팅</a>
      <a href="#sheet">학습설계 상담</a>
    </nav>
    <button type="button" class="print-btn" onclick="window.print()" title="A4 가로 PDF로 인쇄·저장">🖨 PDF 인쇄</button>
  </header>

  <main>
  <div class="hero">
    <p class="eyebrow">Portfolio · AI 서비스 기획 리드</p>
    <h1>상담 통화와 회의 음성을 <em>업무로 연결하는</em> AI 시스템을 직접 만들었습니다</h1>
    <p class="lead">음성을 텍스트로 바꾸는 STT 서비스, 회의록 자동화, 학점취득 학습설계 상담결과지 초안 생성까지 기획하고 구축해 사내에서 운영하고 있습니다. AI는 초안을 만들고 사람이 확인해 확정합니다.</p>
    <div class="wave-box">
      <svg id="wave" viewBox="0 0 660 96" role="img" aria-label="음성 파형이 텍스트 줄로 바뀌는 그림"></svg>
      <div class="wave-cap"><span>음성</span><span>텍스트</span></div>
    </div>
    <div class="hero-meta"><b>정일우</b> · 2026.10 기준<br>해당 포트폴리오는<b>단독으로</b> 기획·설계·개발했습니다. 코드는 Claude Code 등 AI 도구와 협업해 작성했고, 무엇을 어떻게 만들지 정하고 결과를 검수하는 일은 직접 했습니다.</div>
  </div>

  <section id="glance">
    <p class="kicker">Selected Work</p>
    <h2>주요 작업</h2>
    <div class="glance">
      <div class="row head" aria-hidden="true"><span>시스템</span><span>하는 일</span><span>개발</span><span>운영·보강</span></div>
      <div class="row">
        <div class="n">학점LMS 강의 챗봇</div>
        <div class="p">강의 화면에서 차시의 자막과 교안을 근거로 학습자 질문에 답하는 AI 챗봇<small>AI 서비스 중 가장 먼저 만든 기능. 학점LMS 적용은 아직 하지 않았습니다</small></div>
        <div class="w"><span class="lb">개발</span><span class="num">2026.08.06 ~ 08.10</span><small>약 5일</small></div>
        <div class="w"><span class="lb">운영·보강</span><span class="num">도입 전</span><small>개발·테스트 서버에서 검증까지 완료</small></div>
      </div>
      <div class="row">
        <div class="n">OO스크립트<br>통화 변환</div>
        <div class="p">상담 통화 음성을 텍스트로 변환하고 상담자·고객을 나누는 STT 서비스<small>사내 서버에서 운영, 통화 1만 5천여 건 변환</small></div>
        <div class="w"><span class="lb">개발</span><span class="num">2026.09.09 ~ 09.10</span><small>2일, 변환·화자 분리·마스킹·스케줄러</small></div>
        <div class="w"><span class="lb">운영·보강</span><span class="num">2026.09.10 ~ 10.21</span><small>약 6주, 대량 변환 운영과 정확도 보강</small></div>
      </div>
      <div class="row">
        <div class="n">OO스크립트<br>회의 모드</div>
        <div class="p">회의 음성을 변환하고 참석자 이름을 맞춰 OO인사이트로 보내는 기능<small>OO미팅의 변환 구간</small></div>
        <div class="w"><span class="lb">개발</span><span class="num">2026.09.15</span><small>1일, 자동 변환과 NAS 폴더 감시</small></div>
        <div class="w"><span class="lb">운영·보강</span><span class="num">2026.09.16 ~ 10.21</span><small>약 5주, 화자 이름 매칭 개선</small></div>
      </div>
      <div class="row">
        <div class="n">OO미팅</div>
        <div class="p">회의 녹음부터 자동 변환, 요약, 할 일 초안까지 잇는 회의록 자동화<small>OO스크립트·OO인사이트와 연계, 사내 회의에 적용</small></div>
        <div class="w"><span class="lb">개발</span><span class="num">2026.09.15 ~ 09.16</span><small>2일, 끝에서 끝까지 첫 연동</small></div>
        <div class="w"><span class="lb">운영·보강</span><span class="num">2026.09.16 ~ 10.21</span><small>약 5주, 화자 분리와 요약 개선</small></div>
      </div>
      <div class="row">
        <div class="n">학점취득 학습설계<br>상담결과지</div>
        <div class="p">학습설계 상담 접수건의 결과지 초안을 만들고 담당자가 검수·발송하는 시스템<small>운영 서버에서 실제 접수건 처리 중</small></div>
        <div class="w"><span class="lb">개발</span><span class="num">2026.09.15 ~ 09.22</span><small>약 1주, 1차 범위 완료</small></div>
        <div class="w"><span class="lb">운영·보강</span><span class="num">2026.09.22 ~ 10.23</span><small>약 4주, 담당자 의견 반영</small></div>
      </div>
    </div>
    <p class="foot">개발은 첫 버전이 완성되기까지, 운영·보강은 그 뒤 실제로 쓰면서 고친 기간입니다. 개발 기록 기준의 달력 날짜입니다. 이 밖에도 AI를 활용해 수행한 프로젝트가 다수 있으며, 위 다섯 가지는 그중 대표 작업입니다. 전체 목록은 <a href="../file/ai.html">업무수행이력 및 AI 활용역량 기술서</a>에 정리했습니다.</p>
  </section>

  <section id="flow">
    <p class="kicker">Flow</p>
    <h2>음성이 업무로 이어지는 흐름</h2>

    <div class="lane">
      <h3>회의록 <span>OO미팅 → OO스크립트 → OO인사이트</span></h3>
      <ol class="flow" style="--n:5">
        <li><span class="mod">OO미팅</span><span class="t">녹음 프로그램</span><span class="d">회의실에서 실행, 끝나면 자동 업로드</span></li>
        <li><span class="mod">NAS</span><span class="t">음성 파일 보관</span><span class="d">업로드가 끝난 파일만 변환 대상</span></li>
        <li><span class="mod">OO스크립트</span><span class="t">텍스트 변환·화자 분리</span><span class="d">참석자 이름까지 자동 지정</span></li>
        <li><span class="mod">OO인사이트</span><span class="t">요약·할 일 초안</span><span class="d">결정사항, 미결 이슈, 담당자·기한</span></li>
        <li class="human"><span class="mod">사람이 확정</span><span class="t">승인 후 업무 생성</span><span class="d">승인한 할 일만 업무가 됩니다</span></li>
      </ol>
    </div>

    <div class="lane">
      <h3>학점취득 학습설계 상담 <span>OO스크립트 → 규칙 기반 + LLM 분석 → 학습설계 상담결과지</span></h3>
      <ol class="flow" style="--n:5">
        <li><span class="mod">입력</span><span class="t">상담 통화 녹취</span><span class="d">통화 1건당 음성 파일 1개</span></li>
        <li><span class="mod">OO스크립트</span><span class="t">텍스트 변환</span><span class="d">상담자·고객 화자 분리, 개인정보 마스킹</span></li>
        <li><span class="mod">규칙 기반 + LLM</span><span class="t">분석</span><span class="d">통화 유형과 담당자 질문 항목 분류</span></li>
        <li><span class="mod">학습설계 상담결과지</span><span class="t">접수 폼 → 결과지 초안</span><span class="d">분석 결과를 규칙에 반영해 학점 계산과 문장 작성</span></li>
        <li class="human"><span class="mod">사람이 확정</span><span class="t">담당자 검수·발송</span><span class="d">수정하고 확인 항목을 점검한 뒤 발송</span></li>
      </ol>
    </div>
    <p class="legend"><i></i>금색 테두리는 사람이 확인하고 확정하는 단계입니다.</p>
  </section>

  <section id="chat">
    <p class="kicker">System 1</p>
    <h2>학점LMS 강의 챗봇: 강의자료로 답하는 AI</h2>
    <div class="sys-head"><span class="period">개발 2026.08.06 ~ 08.10 · 약 5일 / 학점LMS 도입 전</span></div>
    <ul class="plain">
      <li><b>강의 화면 안에서 질문하고 답을 받습니다.</b> 학습자가 보고 있는 차시의 자막과 교안을 근거로 Gemini가 답합니다.</li>
      <li><b>자료를 검색하지 않고 통째로 근거로 삼습니다.</b> 차시의 자막과 교안 전체를 세션당 한 번 올려 두고 대화 내내 재사용합니다.</li>
      <li><b>기존 챗봇 코드를 분석해 다시 설계했습니다.</b> 응답을 기다리는 동안 DB 연결을 붙잡는 문제 등 기존 방식의 약점을 확인하고 피하도록 구조를 잡았습니다.</li>
      <li><b>운영용 관리 화면까지 만들었습니다.</b> API 키 발급, 프롬프트 버전 관리, 대화 이력, 사용량과 영상별 통계.</li>
      <li><b>5일 만에 설계한 8개 단계(Phase 0~7)와 배포 구성을 마쳤습니다.</b> 실제 서버에서 질문, 답변, 이력 조회까지 이어지는 흐름을 검증했습니다. 이 저장소에 이후 상담결과지가 추가됐습니다.</li>
    </ul>
    <div class="shots">
      <figure class="shot narrow">
        <a class="img" href="img/01_chatbot.png" target="_blank" rel="noopener"><img src="img/01_chatbot.png" alt="AI 학습 도우미 챗봇 화면: 개념 질문에 핵심 요약, 상세 설명 형식으로 답변" width="864" height="2416" loading="lazy"></a>
        <figcaption>강의 화면의 챗봇: 핵심 요약, 상세 설명, 심화 학습 가이드 형식으로 답합니다 (클릭하면 크게 봅니다)</figcaption>
      </figure>
      <figure class="shot wide">
        <a class="img" href="img/01b_admin_prompt.png" target="_blank" rel="noopener"><img src="img/01b_admin_prompt.png" alt="관리 화면의 프롬프트 관리: 새 버전 등록과 버전 이력" width="1553" height="752" loading="lazy"></a>
        <figcaption>관리 화면의 프롬프트 관리: 저장하면 새 버전으로 등록되고 바로 적용됩니다 (클릭하면 크게 봅니다)</figcaption>
      </figure>
    </div>
  </section>

  <section id="script">
    <p class="kicker">System 2</p>
    <h2>OO스크립트: 통화·회의 음성을 텍스트로</h2>
    <div class="sys-head"><span class="period">통화 변환: 개발 2026.09.09 ~ 09.10 · 2일 / 운영·보강 ~ 10.21 · 약 6주</span></div>
    <div class="sys-head"><span class="period">회의 모드: 개발 2026.09.15 · 1일 / 운영·보강 ~ 10.21 · 약 5주</span></div>
    <ul class="plain">
      <li><b>외부 STT 서비스 없이 사내에서 변환합니다.</b> Whisper large-v3로 한국어 음성을 변환하고 화자 분리 모델로 상담자와 고객을 나눕니다.</li>
      <li><b>정확도를 보완하는 장치를 넣었습니다.</b> 업무 용어사전과 교정 규칙, 무음 구간에서 없는 말이 생기는 오류 제거, 의심 구간 자동 표시.</li>
      <li><b>화자 이름을 자동으로 붙입니다.</b> 통화 앞 인사말로 역할을 판정하고 내선표로 담당자 이름을 지정합니다.</li>
      <li><b>웹 화면에서 바로 고칩니다.</b> 변환 이력 조회, 화자 변경, AI 검증(오인식·화자 뒤바뀜 후보 표시), 용어사전 관리.</li>
      <li><b>개인정보는 내보내기 전에 가립니다.</b> 주민번호, 전화번호, 이메일, 카드·계좌번호 패턴을 마스킹하고 파일명도 비식별로 바꿉니다.</li>
      <li><b>대량 변환을 운영합니다.</b> 하루 투입량을 조절하는 스케줄러, 작업 중단 시 자동 재시작, GPU 온도 감시.</li>
    </ul>
    <div class="shots">
      <figure class="shot wide">
        <a class="img" href="img/03_script_ai_review.png" target="_blank" rel="noopener"><img src="img/03_script_ai_review.png" alt="OO스크립트 AI 검증 결과: 화자 뒤바뀜 의심 구간과 통화 유형 분류" width="1827" height="940" loading="lazy"></a>
        <figcaption>AI 검증 결과: 화자가 뒤바뀐 것으로 의심되는 구간을 시각과 사유로 지적하고 통화 유형을 분류 (가상 통화 내용, 클릭하면 크게 봅니다)</figcaption>
      </figure>
      <figure class="shot wide">
        <a class="img" href="img/04b_script_dict.png" target="_blank" rel="noopener"><img src="img/04b_script_dict.png" alt="OO스크립트 용어사전과 오인식 교정 규칙 화면" width="1833" height="903" loading="lazy"></a>
        <figcaption>정확도 보완: 자주 틀리는 업무 용어를 등록하는 용어사전과, 잘못된 표기를 확정적으로 바로잡는 교정 규칙</figcaption>
      </figure>
    </div>
  </section>

  <section id="meeting">
    <p class="kicker">System 3</p>
    <h2>OO미팅: 회의 녹음부터 할 일 초안까지</h2>
    <div class="sys-head"><span class="period">개발 2026.09.15 ~ 09.16 · 2일 / 운영·보강 ~ 10.21 · 약 5주</span></div>
    <ul class="plain">
      <li><b>녹음 프로그램(exe)을 직접 만들었습니다.</b> 설치 없이 실행되고, 참석자를 입력하고 녹음을 시작하면 끝날 때 자동으로 업로드합니다. 무음 녹음은 보내기 전에 걸러내고, 전송이 실패하면 성공할 때까지 다시 시도합니다.</li>
      <li><b>업로드부터 변환까지 자동입니다.</b> NAS에 파일이 올라오면 OO스크립트가 변환하고 화자를 나눈 뒤 참석자 명단으로 이름을 맞춰 OO인사이트로 보냅니다.</li>
      <li><b>OO인사이트에서 AI가 회의록을 정리합니다.</b> 요약, 결정사항, 미결 이슈, 발언자별 요점, 담당자와 기한이 붙은 할 일 초안을 만듭니다.</li>
      <li><b>할 일은 사람이 승인해야 업무가 됩니다.</b> 담당자 이름이 모호하면 자동으로 배정하지 않습니다.</li>
      <li><b>웹에서 확인하고 고칩니다.</b> 회의 목록, 요약 화면, 화자별 원문, 원문 검색, 원음성 재생, 줄 단위 수정.</li>
    </ul>
    <div class="shots">
      <figure class="shot narrow">
        <a class="img" href="img/04_recorder.png" target="_blank" rel="noopener"><img src="img/04_recorder.png" alt="회의 녹음 프로그램 화면: 입력 장치와 입력 레벨, 참석자 선택, 전송 대기 상태" width="578" height="669" loading="lazy"></a>
        <figcaption>녹음 프로그램: 입력 레벨 확인, 참석자 선택, 전송 대기 상태 (가상 참석자)</figcaption>
      </figure>
      <figure class="shot wide">
        <a class="img" href="img/05_meeting_overview.png" target="_blank" rel="noopener"><img src="img/05_meeting_overview.png" alt="회의록 상세 개요 탭: 요약, 결정사항, 미결 이슈, 발언자별 입장, 발언 비율, 할 일 초안 표" width="1580" height="1204" loading="lazy"></a>
        <figcaption>회의록 개요 탭: 요약, 결정사항, 발언 비율, 할 일 초안과 승인 상태 (가상 회의 내용, 클릭하면 크게 봅니다)</figcaption>
      </figure>
      <figure class="shot wide">
        <a class="img" href="img/06_meeting_transcript.png" target="_blank" rel="noopener"><img src="img/06_meeting_transcript.png" alt="회의록 상세 원문 탭: 화자별 원문, 검색, 원음성 재생, 저신뢰 구간 표시" width="1587" height="735" loading="lazy"></a>
        <figcaption>원문 탭: 화자별 원문, 검색, 원음성 재생, 신뢰도가 낮은 구간 표시 (가상 회의 내용, 클릭하면 크게 봅니다)</figcaption>
      </figure>
    </div>
  </section>

  <section id="sheet">
    <p class="kicker">System 4</p>
    <h2>학점취득 학습설계 상담결과지: 접수 폼에서 결과지 초안까지</h2>
    <div class="sys-head"><span class="period">개발 2026.09.15 ~ 09.22 · 약 1주 / 운영·보강 ~ 10.23 · 약 4주</span></div>
    <ul class="plain">
      <li><b>판정 순서를 직접 설계했습니다.</b> 접수 정보가 충분한지 확인하고, 전공을 맞추고, 부족한 정보를 찾고, 학점을 계산하고, 문장을 쓰는 순서를 순서도로 정의했습니다.</li>
      <li><b>계산은 코드가, 문장은 LLM이 맡습니다.</b> 학점 계산 규칙이 필요 학점과 소요 학기를 계산하고, LLM은 그 결과를 상담 문장으로 풀어 씁니다. 계산에 없는 숫자가 문장에 나오면 확인 항목으로 표시합니다.</li>
      <li><b>통화 분석을 규칙에 반영했습니다.</b> OO스크립트로 변환한 상담 통화 1만 5천여 건에서 담당자의 질문 패턴을 분류하고, 그 결과를 계산 규칙과 지식에 사람이 정리해 넣었습니다.</li>
      <li><b>담당자가 최종 확정합니다.</b> 결과지는 희망과정, 필요 학점 표, 주요 상담내용, 향후 해야 할 일로 구성되고, 담당자가 수정한 뒤 PDF 또는 메일로 발송합니다.</li>
      <li><b>운영하며 고칩니다.</b> 담당자가 남긴 의견 309건을 분류해 규칙과 지식을 25회 이상 수정했습니다.</li>
    </ul>
    <div class="shots">
      <figure class="shot wide">
        <div class="algo-box" role="group" aria-label="상담결과지 생성 순서도 요약">
          <p class="algo-key"><span><i class="k-code"></i>코드 계산 (같은 입력은 같은 결과)</span><span><i class="k-llm"></i>AI 작성·해석</span><span><i class="k-human"></i>사람 확인</span></p>
          <ol class="flow algo" style="--n:5">
            <li><span class="mod">① 입력</span><span class="t">입력 모으기</span><span class="d">접수 폼 항목과 상담 내용</span></li>
            <li class="llm"><span class="mod">② AI</span><span class="t">입력 해석</span><span class="d">상담 내용에서 사실을 원문 인용과 함께 추출</span></li>
            <li class="code"><span class="mod">③ 코드</span><span class="t">충돌 점검</span><span class="d">원문 근거 확인, 신청서와 상담 내용이 다르면 재신청 요청</span></li>
            <li class="code"><span class="mod">④ 코드</span><span class="t">계산 가능 여부</span><span class="d">정보가 모자라면 계산 불가로 안내</span></li>
            <li class="code"><span class="mod">⑤ 코드</span><span class="t">과정 판정</span><span class="d">응시·일반·타전공 경로 구분</span></li>
          </ol>
          <p class="algo-turn">이어서 ↓</p>
          <ol class="flow algo" style="--n:5">
            <li class="code"><span class="mod">⑥ 코드</span><span class="t">학점 계산 (규칙)</span><span class="d">필요·인정·부족 학점, 자격증 최적 조합</span></li>
            <li class="code"><span class="mod">⑦ 코드</span><span class="t">정보 충분성 게이트</span><span class="d">결과지를 쓸지, 선상담으로 돌릴지 결정</span></li>
            <li class="llm"><span class="mod">⑧ AI</span><span class="t">문장 작성</span><span class="d">계산된 사실을 상담 문장으로</span></li>
            <li class="code"><span class="mod">⑨ 코드</span><span class="t">숫자 대조</span><span class="d">계산에 없는 숫자는 확인 항목으로 표시</span></li>
            <li class="human"><span class="mod">⑩ 사람</span><span class="t">담당자 검수·발송</span><span class="d">수정 후 PDF 또는 메일로 발송</span></li>
          </ol>
          <p class="algo-stop"><b>분기.</b> 충돌이 있으면 재신청을 요청하고, 계산할 수 없으면 계산 불가로 알립니다. ⑦에서는 정보가 충분한지에 따라 선상담 안내, 단서·축약을 붙인 결과지, 일반 결과지 중 하나로 나뉩니다.</p>
        </div>
        <figcaption>결과지 생성 순서 요약: 계산은 코드, 문장은 AI, 확정은 사람이 맡습니다.</figcaption>
      </figure>
      <figure class="shot wide">
        <details class="flowset">
          <summary>분기까지 모두 그린 순서도 보기 (3장)</summary>
          <div class="flowimgs">
            <a class="img" href="img/flow_A.png" target="_blank" rel="noopener"><img src="img/flow_A.png" alt="상담결과지 전체 분기 순서도: 입력 해석, 충돌 점검, 계산 가능 여부, 과정 판정, 학점 계산, 정보 충분성 게이트와 결과 유형" width="1500" height="2006" loading="lazy"></a>
            <p class="cap">① 전체 분기: 입력 해석부터 결과 유형까지</p>
            <a class="img" href="img/flow_C.png" target="_blank" rel="noopener"><img src="img/flow_C.png" alt="과정 판정 순서도: 응시 경로, 타전공 경로, 일반 경로와 학점은행제 상한" width="1800" height="1525" loading="lazy"></a>
            <p class="cap">② 과정 판정: 자격증 응시, 타전공, 일반 경로를 가르는 분기</p>
            <a class="img" href="img/flow_B.png" target="_blank" rel="noopener"><img src="img/flow_B.png" alt="정보 충분성 게이트 순서도: 선상담 안내, 축약 결과지, 확인 문구가 붙는 결과지, 일반 결과지" width="1100" height="2682" loading="lazy"></a>
            <p class="cap">③ 정보 충분성 게이트: 선상담 · 단서·축약 결과지 · 일반 결과지</p>
          </div>
        </details>
      </figure>
    </div>
  </section>

  </main>

  <footer>
    <p>실제 통화·회의 내용과 담당자·참석자 이름은 싣지 않았습니다. 화면 속 이름, 파일명, 대화 내용은 가상 데이터로 바꿔 실었습니다.</p>
  </footer>
</div>

<script>
(function () {
  var el = document.getElementById('wave');
  if (el) {
    var s = '<g fill="currentColor" opacity=".85" style="color:var(--on-navy)">';
    var i, h, env, n;
    function r(k) { var t = Math.sin(k * 12.9898) * 43758.5453; return t - Math.floor(t); }
    for (i = 0; i < 48; i++) {
      env = Math.sin(Math.PI * i / 47) * 0.55 + 0.35;
      h = 10 + (r(i + 1) * 0.7 + 0.3) * env * 76;
      s += '<rect x="' + (i * 8) + '" y="' + (48 - h / 2).toFixed(1) + '" width="4.5" height="' + h.toFixed(1) + '" rx="2.25"/>';
    }
    s += '</g>';
    s += '<path d="M396 48h22m-7-7l7 7l-7 7" fill="none" stroke="var(--gold)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>';
    var w = [196, 168, 204, 140, 182];
    for (n = 0; n < w.length; n++) {
      s += '<rect x="436" y="' + (13 + n * 16) + '" width="' + w[n] + '" height="5" rx="2.5" style="fill:' + (n === 2 ? 'var(--gold)' : 'var(--on-navy)') + '" opacity="' + (n === 2 ? 1 : 0.7) + '"/>';
    }
    el.innerHTML = s;
  }

  // 인쇄 시 접힌 상세(흐름도)도 펼쳐서 출력하고, 끝나면 원래 상태로 되돌린다
  var reopen = [];
  window.addEventListener('beforeprint', function () {
    reopen = [];
    document.querySelectorAll('details:not([open])').forEach(function (d) { d.open = true; reopen.push(d); });
  });
  window.addEventListener('afterprint', function () {
    reopen.forEach(function (d) { d.open = false; });
    reopen = [];
  });

  var links = Array.prototype.slice.call(document.querySelectorAll('#nav a'));
  var map = {};
  links.forEach(function (a) { map[a.getAttribute('href').slice(1)] = a; });
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) {
          links.forEach(function (a) { a.classList.remove('on'); });
          var a = map[e.target.id];
          if (a) {
            a.classList.add('on');
            var nav = document.getElementById('nav');
            if (nav && nav.scrollWidth > nav.clientWidth) { nav.scrollLeft = a.offsetLeft - 40; }
          }
        }
      });
    }, { rootMargin: '-25% 0px -65% 0px' });
    Object.keys(map).forEach(function (id) {
      var s = document.getElementById(id);
      if (s) io.observe(s);
    });
  }
})();
</script>
